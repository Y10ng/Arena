# Server 与 Dispatcher 脚本部署参数；命令行 --host/--port 的优先级更高。
ARENA_SERVER_HOST=0.0.0.0
ARENA_SERVER_PORT=8000
ARENA_ADMIN_LOGIN=admin
ARENA_DISPATCHER_NAME=dispatcher-main
CAIRN_DISPATCHER_HARD_CAP=64

# 留空或保留默认 loopback 值时，start.sh 会按实际端口自动派生 localhost Origin。
# 远程 IP、公开域名或 HTTPS 反向代理必须填写浏览器实际访问的精确 Origin。
CAIRN_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# 直接 HTTP 部署保持 0；经 HTTPS 反向代理对外服务时设为 1。
CAIRN_SESSION_COOKIE_SECURE=0

# 默认不设置 CAIRN_DATABASE_URL：start.sh 会管理 DB-only PostgreSQL Compose，
# 并从 runtime/postgres.env 在内存中派生 URL，不会把密码复制到本文件。
# 只有显式设置非空 URL 才进入 External PostgreSQL 模式；该模式不会启动或修改内置数据库。
# CAIRN_DATABASE_URL=postgresql://cairn:URL_ENCODED_PASSWORD@db.example:5432/cairn
# 生产环境应显式设置持久化 Artifact 和 Project Resource root；PostgreSQL dump 不包含这些文件。
# CAIRN_ARTIFACT_ROOT=/srv/arena/artifacts
# CAIRN_PROJECT_RESOURCE_ROOT=/srv/arena/project-resources

# 项目辅助资料配额；未设置时依次默认 200 个、单文件 10 MiB、总计 100 MiB、ZIP 上传 50 MiB。
# ZIP 由 Server 安全展开，内嵌归档不会递归解压；临时批次默认保留 24 小时。
# CAIRN_PROJECT_RESOURCE_MAX_ACTIVE_COUNT=200
# CAIRN_PROJECT_RESOURCE_MAX_FILE_BYTES=10485760
# CAIRN_PROJECT_RESOURCE_MAX_ACTIVE_TOTAL_BYTES=104857600
# CAIRN_PROJECT_RESOURCE_MAX_ZIP_UPLOAD_BYTES=52428800
# CAIRN_PROJECT_RESOURCE_MAX_ZIP_ENTRIES=1000
# CAIRN_PROJECT_RESOURCE_MAX_COMPRESSION_RATIO=100
# CAIRN_PROJECT_RESOURCE_MAX_OPEN_BATCHES_PER_USER=4
# CAIRN_PROJECT_RESOURCE_MAX_STAGED_BYTES_PER_USER=209715200
# CAIRN_PROJECT_RESOURCE_MAX_PATH_BYTES=1024
# CAIRN_PROJECT_RESOURCE_MAX_PATH_SEGMENT_BYTES=255
# CAIRN_PROJECT_RESOURCE_BATCH_TTL_SECONDS=86400

# 默认 keyring 由 start.sh 自动生成到 runtime/secrets/model-credential-keyring.json。
# 仅在需要外部 keyring 时配置绝对路径；文件必须属于 Server 用户且权限为 0600。
# 数据库备份必须配套保存匹配 keyring，包括仍被 ciphertext 引用的历史 key versions。
# CAIRN_MODEL_CREDENTIAL_KEYRING_FILE=/secure/path/model-credential-keyring.json

# 数据库 URL 与 Model keyring 只提供给 Server，Dispatcher 不读取二者。
# Dispatcher token 默认自动生成到 runtime/secrets/dispatcher.token，不写入此环境文件。
# 如需轮换，使用显式运维命令并安全替换该文件；不要把 token 写入日志或版本控制。

# Legacy Dispatcher Provider credential 通过 Server API 写入 runtime/dispatch.yaml 的 common_env；
# 与 Tenant Model keyring 相互独立。
